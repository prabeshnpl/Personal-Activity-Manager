# -----------------------------------------------------------------------------
# STAGE 1: Development Environment
# -----------------------------------------------------------------------------
# This stage is for development where Vite's server runs with hot reloading.
# -----------------------------------------------------------------------------
FROM node:22-bookworm-slim AS development

# Set working directory inside the container
WORKDIR /app

# Copy dependency files into container
COPY FrontEnd/project-manager/package*.json ./

# Install all dependencies required for development.
# --legacy-peer-deps avoids strict peer dependency resolution issues.
RUN npm ci --legacy-peer-deps

# Copy application source code into the container.
COPY FrontEnd/project-manager/ ./

# Vite development server port
EXPOSE 5173

# Start Vite dev server and make it accessible outside the container.
# 0.0.0.0 allows access from the host machine.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]


# -----------------------------------------------------------------------------
# STAGE 2: Build Stage
# -----------------------------------------------------------------------------
# Creates an optimized production build of the frontend.
# Alpine is used here because it is lightweight and sufficient for building.
# -----------------------------------------------------------------------------
FROM node:22-alpine AS builder

# Set working directory
WORKDIR /app

# Copy dependency definitions
COPY FrontEnd/project-manager/package*.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy application source code
COPY FrontEnd/project-manager/ ./

# Generate optimized static files into /app/dist
RUN npm run build


# -----------------------------------------------------------------------------
# STAGE 3: Production Runtime
# -----------------------------------------------------------------------------
# Uses Nginx to serve the static files generated by the build stage.
# No Node.js runtime is needed in production.
# -----------------------------------------------------------------------------
FROM nginx:alpine AS production

# Copy custom Nginx configuration.
# Typically used for:
# - SPA routing (React Router)
# - Reverse proxy configuration
# - Caching policies
# - Security headers
COPY FrontEnd/nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend assets from the builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Nginx HTTP port
EXPOSE 80

# Start Nginx in the foreground so the container stays alive
CMD ["nginx", "-g", "daemon off;"]